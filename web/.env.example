# ✦ KRYVANTA ECOSYSTEM ✦ — пример переменных окружения.
# Скопируйте в .env и заполните. Никогда не коммитьте .env в git.

# --- База данных PostgreSQL ---
DATABASE_URL="postgresql://kryvanta:CHANGE_ME@127.0.0.1:5432/kryvanta?schema=public"

# --- Публичный адрес сайта (без слеша в конце). Используется для CSRF-проверки, ссылок и вебхуков ---
APP_URL="https://kryvanta.example.com"

# --- Секреты (сгенерируйте: openssl rand -hex 32) ---
# Соль для хэширования IP-адресов и одноразовых кодов
APP_SECRET="CHANGE_ME_64_HEX_CHARS"
# Общий секрет между сайтом и Minecraft-плагином (тот же ключ указывается в plugins/Kryvanta/config.yml -> api.secret)
PLUGIN_API_SECRET="CHANGE_ME_64_HEX_CHARS"

# --- Платежи ---
# Провайдер: manual | test | yookassa
#   manual   — заказ ждёт ручного подтверждения администратором в /admin (безопасный режим по умолчанию)
#   test     — тестовый провайдер с подписанным вебхуком (ЗАПРЕЩЁН при NODE_ENV=production без ALLOW_TEST_PAYMENTS=true)
#   yookassa — ЮKassa, официальное API v3 (https://yookassa.ru/developers/api)
PAYMENT_PROVIDER="manual"
ALLOW_TEST_PAYMENTS="false"
# Секрет подписи тестовых вебхуков
TEST_PAYMENT_SECRET="CHANGE_ME_64_HEX_CHARS"

# ЮKassa (заполните, если PAYMENT_PROVIDER=yookassa)
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""
# Через запятую. Используется для проверки источника HTTP-уведомлений ЮKassa (официальный список из документации).
YOOKASSA_ALLOWED_IPS="185.71.76.0/27,185.71.77.0/27,77.75.153.0/25,77.75.156.11/32,77.75.156.35/32,77.75.154.128/25,2a02:5180::/32"
# Доверять заголовку X-Forwarded-For (только если сайт стоит за вашим reverse-proxy, например nginx)
TRUST_PROXY="true"

# --- Первый администратор (создаётся командой npm run db:seed, если ещё нет пользователей с ролью ADMIN) ---
SEED_ADMIN_EMAIL="admin@kryvanta.example.com"
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="CHANGE_ME_STRONG_PASSWORD"

# --- Информация о сервере (отображается на сайте) ---
NEXT_PUBLIC_SERVER_IP="m3.nexuz.ru:41058"
NEXT_PUBLIC_DISCORD_URL="https://discord.gg/bsrudxHwV"
NEXT_PUBLIC_MC_VERSION="1.21.11"

# --- Только для Vercel: секрет для ежедневного обслуживания (/api/cron/maintenance) ---
CRON_SECRET="CHANGE_ME_64_HEX_CHARS"
